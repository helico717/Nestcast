+void LoopingFileCastAgent::SetReceiverVolume(std::optional<double> level,
+                                             std::optional<bool> muted) {
+  if (!platform_remote_connection_ || (!level && !muted)) {
+    return;
+  }
+  std::string volume;
+  if (level) {
+    volume = std::format(R"("level":{:.3f})", std::clamp(*level, 0.0, 1.0));
+  }
+  if (muted) {
+    volume += std::format(R"({}"muted":{})", volume.empty() ? "" : ",",
+                          *muted ? "true" : "false");
+  }
+  router_.Send(*platform_remote_connection_,
+               MakeSimpleUTF8Message(
+                   kReceiverNamespace,
+                   std::format(R"({{"type":"SET_VOLUME", "requestId":{}, )"
+                               R"("volume":{{{}}}}})",
+                               next_request_id_++, volume)));
+}
