+std::string LoopingFileCastAgent::FindOtherActiveApp(
+    const Json::Value& status) const {
+  const Json::Value& apps = status[kMessageKeyStatus][kMessageKeyApplications];
+  if (!status[kMessageKeyStatus].isObject() || !apps.isArray()) {
+    return {};
+  }
+  for (const Json::Value& app : apps) {
+    std::string app_id;
+    json::TryParseString(app[kMessageKeyAppId], &app_id);
+    if (app_id.empty() || app_id == GetStreamingAppId()) {
+      continue;
+    }
+    if (app["isIdleScreen"].isBool() && app["isIdleScreen"].asBool()) {
+      continue;  // Backdrop / ambient screen: the receiver is idle.
+    }
+    std::string name;
+    if (!json::TryParseString(app["displayName"], &name) || name.empty()) {
+      name = app_id;
+    }
+    return name + " (" + app_id + ")";
+  }
+  return {};
+}
