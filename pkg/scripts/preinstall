#!/bin/zsh
# Nestcast installer: pre-install (runs as root). Stops a running Nestcast so
# its files can be replaced; the Hub gets its volume back on the way out.
exec >>/tmp/nestcast-install.log 2>&1
echo "== preinstall $(date)"
USER_NAME=$(stat -f %Su /dev/console)
if [[ -n "$USER_NAME" && "$USER_NAME" != "root" ]]; then
  launchctl bootout "gui/$(id -u "$USER_NAME")/local.nestcast" 2>/dev/null || true
  launchctl bootout "gui/$(id -u "$USER_NAME")/local.nestcast.menu" 2>/dev/null || true
  launchctl bootout "gui/$(id -u "$USER_NAME")/local.nestcast.ui" 2>/dev/null || true
fi
# Older layouts: up to 0.1.1, /Applications/Nestcast.app was the engine
# itself (Contents/MacOS/nestcast-core); an early 0.1.2 build could end up in
# /Applications/Nestcast.localized. Remove both so this install is clean.
OLD=/Applications/Nestcast.app
if [[ -x "$OLD/Contents/MacOS/nestcast-core" ]]; then
  rm -rf "$OLD"
  echo "removed old engine-only bundle"
fi
if [[ -d /Applications/Nestcast.localized/Nestcast.app ]]; then
  rm -rf /Applications/Nestcast.localized
  echo "removed /Applications/Nestcast.localized"
fi
exit 0
