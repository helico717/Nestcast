#!/bin/zsh
# Nestcast installer: post-install (runs as root).
# - Fixes ownership of the audio driver and restarts Core Audio to load it.
# - Installs and starts the per-user LaunchAgent for the logged-in user.
LOG=/tmp/nestcast-install.log
exec >>$LOG 2>&1
echo "== postinstall $(date)"

chown -R root:wheel "/Library/Audio/Plug-Ins/HAL/NestHubCast.driver"
# Restart Core Audio (to load the driver) only when the driver changed, and
# via launchd rather than killing it; then wait until it answers again.
DRV=/Library/Audio/Plug-Ins/HAL/NestHubCast.driver/Contents/MacOS/NestHubCast
NEW_SHA=$(shasum -a 256 "$DRV" | cut -d' ' -f1)
if [[ "$NEW_SHA" != "$(cat /tmp/nestcast-driver.sha 2>/dev/null)" ]]; then
  echo "driver changed; restarting Core Audio"
  launchctl kickstart -k system/com.apple.audio.coreaudiod 2>/dev/null || killall coreaudiod 2>/dev/null || true
  for i in {1..30}; do
    sleep 1
    if /usr/bin/perl -e "alarm 4; exec @ARGV" /usr/sbin/system_profiler SPAudioDataType >/dev/null 2>&1; then
      echo "Core Audio is back after ${i}s"
      break
    fi
  done
else
  echo "driver unchanged; Core Audio not restarted"
fi
rm -f /tmp/nestcast-driver.sha

USER_NAME=$(stat -f %Su /dev/console)
if [[ -z "$USER_NAME" || "$USER_NAME" == "root" || "$USER_NAME" == "loginwindow" ]]; then
  echo "no console user; the LaunchAgent will be installed on next run of the installer"
  exit 0
fi
USER_ID=$(id -u "$USER_NAME")
USER_HOME=$(dscl . -read "/Users/$USER_NAME" NFSHomeDirectory | awk '{print $2}')
AGENT_DIR="$USER_HOME/Library/LaunchAgents"
AGENT="$AGENT_DIR/local.nestcast.plist"

mkdir -p "$AGENT_DIR" "$USER_HOME/Library/Logs"
cat > "$AGENT" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.nestcast</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Nestcast.app/Contents/Helpers/Nestcast Engine.app/Contents/MacOS/Nestcast</string>
    <string>--playout</string><string>300</string>
    <string>--mute</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>StandardOutPath</key><string>$USER_HOME/Library/Logs/nestcast.log</string>
  <key>StandardErrorPath</key><string>$USER_HOME/Library/Logs/nestcast.log</string>
</dict>
</plist>
EOF
chown "$USER_NAME":staff "$AGENT"
chmod 644 "$AGENT"

# The Nestcast app at login: runs in the background only if its menu bar
# icon is enabled (otherwise it exits at once). The engine is separate.
UI_AGENT="$AGENT_DIR/local.nestcast.ui.plist"
cat > "$UI_AGENT" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.nestcast.ui</string>
  <key>ProgramArguments</key>
  <array><string>/Applications/Nestcast.app/Contents/MacOS/Nestcast</string><string>--background</string></array>
  <key>RunAtLoad</key><true/>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
</dict>
</plist>
PLIST
chown "$USER_NAME":staff "$UI_AGENT"
chmod 644 "$UI_AGENT"
# The app's first launch (by the agent below) opens its window once.
CONF="$USER_HOME/Library/Application Support/nestcast"
mkdir -p "$CONF" && touch "$CONF/show_window" && chown -R "$USER_NAME":staff "$CONF"
# Remove pieces of older versions (0.1.0 chooser, 0.1.2 menu bar app).
launchctl bootout "gui/$USER_ID/local.nestcast.menu" 2>/dev/null || true
rm -f "$AGENT_DIR/local.nestcast.menu.plist"
rm -rf "/Applications/Nestcast 스피커 선택.app" "/Applications/Nestcast Menu.app"

launchctl bootout "gui/$USER_ID/local.nestcast.ui" 2>/dev/null || true
launchctl bootstrap "gui/$USER_ID" "$UI_AGENT" || true
launchctl bootout "gui/$USER_ID/local.nestcast" 2>/dev/null || true
for attempt in 1 2 3 4 5; do
  if launchctl bootstrap "gui/$USER_ID" "$AGENT"; then
    echo "LaunchAgent started for $USER_NAME"
    exit 0
  fi
  sleep 2
done
echo "WARNING: could not start the LaunchAgent; it will start at next login"
exit 0
