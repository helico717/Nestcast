<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>local.nestcast</string>
  <key>CFBundleName</key><string>Nestcast</string>
  <key>CFBundleDisplayName</key><string>Nestcast</string>
  <key>CFBundleExecutable</key><string>Nestcast</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.1</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSMinimumSystemVersion</key><string>26.0</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>
  <key>NSHumanReadableCopyright</key><string>GPL-3.0</string>
  <!-- macOS attributes the engine helper's privacy access to this app, so the
       usage descriptions must be here too (without them access is silently
       denied: the audio tap delivers only silence). -->
  <key>NSAudioCaptureUsageDescription</key><string>Nestcast captures the Mac's audio to play it on your Google Cast speaker.</string>
  <key>NSLocalNetworkUsageDescription</key><string>Nestcast streams audio to Google Cast speakers on your local network.</string>
  <key>NSBonjourServices</key><array><string>_googlecast._tcp</string></array>
</dict>
</plist>
